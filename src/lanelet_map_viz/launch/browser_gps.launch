<launch>
    <!-- Map file path — change this to your actual map location -->
    <arg name="map_file" default="$(find lanelet_map_viz)/maps/wes_roads_shifted.osm"/>
    
    <!--
    <include file="$(find piksi_multi_rtk_ros)/launch/piksi_multi_rover.launch">
        <arg name="interface" value="tcp"/>
        <arg name="tcp_addr"  value="192.168.0.222"/>
    </include>

    <node pkg="lanelet_map_viz" type="vehicle_pose_node.py" name="vehicle_pose_node"
          output="screen"/>
    -->

    <node pkg="lanelet_map_viz" type="viz_browser.py" name="lanelet_web_viz"
          output="screen">
        <param name="map_file" value="$(arg map_file)"/>
    </node>
</launch>
